<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:padding="15dp"
    android:layout_height="230dp">

    <TextView
        android:id="@+id/idSolicitationId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Id:"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/idSolicitation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:text="-"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@+id/idSolicitationId"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/solicitationOperatorLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Operadora:"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/idSolicitationId" />

    <TextView
        android:id="@+id/solicitationOperator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-"
        android:textSize="16sp"
        android:layout_margin="10dp"
        app:layout_constraintStart_toEndOf="@+id/solicitationOperatorLabel"
        app:layout_constraintTop_toBottomOf="@+id/idSolicitation" />

    <TextView
        android:id="@+id/solicitationOperatorIdLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/solicitationOperatorLabel" />

    <TextView
        android:id="@+id/solicitationOperatorId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:text="3"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@+id/solicitationOperatorIdLabel"
        app:layout_constraintTop_toBottomOf="@+id/solicitationOperator" />

    <TextView
        android:id="@+id/solicitationTypeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tipo:"
        android:textSize="16sp"
        android:layout_marginTop="10dp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/solicitationOperatorIdLabel" />

    <TextView
        android:id="@+id/solicitationType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="-"
        android:textSize="16sp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toEndOf="@+id/solicitationTypeLabel"
        app:layout_constraintTop_toBottomOf="@+id/solicitationOperatorId" />

    <TextView
        android:id="@+id/solicitationDateLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Data:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/solicitationTypeLabel" />

    <TextView
        android:id="@+id/solicitationDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="10dp"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@+id/solicitationDateLabel"
        app:layout_constraintTop_toBottomOf="@+id/solicitationType" />

    <TextView
        android:id="@+id/solicitationStatusLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/solicitationDateLabel" />

    <TextView
        android:id="@+id/solicitationStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-"
        android:textSize="16sp"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="10dp"
        app:layout_constraintStart_toEndOf="@+id/solicitationStatusLabel"
        app:layout_constraintTop_toBottomOf="@+id/solicitationDate" />


</androidx.constraintlayout.widget.ConstraintLayout>